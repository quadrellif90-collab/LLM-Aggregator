{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LLM Aggregator",
  "version": "0.1.0",
  "identifier": "com.llmaggregator.desktop",
  "build": {
    "beforeDevCommand": "node server/index.js",
    "devUrl": "http://localhost:9090/",
    "beforeBuildCommand": "echo skip",
    "frontendDist": "../panel"
  },
  "app": {
    "windows": [
      {
        "title": "LLM Aggregator",
        "width": 1100,
        "height": 720,
        "url": "http://localhost:9090/",
        "resizable": true,
        "visible": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../server/": "server/",
      "../config.json": "config.json",
      "../prefs.json": "prefs.json",
      "../pricing.json": "pricing.json",
      "../panel/": "panel/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
